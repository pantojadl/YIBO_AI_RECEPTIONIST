# Process/deployment settings.
# Containers should bind 0.0.0.0; local development defaults to 127.0.0.1 when HOST is unset.
# HOST=0.0.0.0
# NODE_ENV=production

# Local trusted access context. In production this comes from authentication/session claims.
YIBO_REGION=MX
YIBO_TENANT_ID=tenant-yibo-demo

# Local Developer Test Mode is disabled by default. Set to 1 only while testing
# through the local voice harness; it is never enabled for normal API sessions.
# YIBO_LOCAL_DEVELOPER_TEST_MODE=1

# Conversation runtime. API and admin keys are different secrets.
YIBO_RUNTIME=in-memory
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Hard per-call OpenAI cap. Either limit ends the call with a short farewell.
# YIBO_CALL_MAX_MINUTES=15
# YIBO_CALL_MAX_TOKENS=150000

# Google Calendar integration. Keep these values only in .env, never Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Deprecated one-time import into the default location; configure mappings through Business afterwards.
GOOGLE_CALENDAR_ID=
# Generate locally with: openssl rand -hex 32
YIBO_TOKEN_ENCRYPTION_KEY=

# Database locations. Local development may use defaults under data/. Production release
# preflight requires an explicit path for the active YIBO_REGION; mount it on durable storage.
# YIBO_DATABASE_MX=/var/lib/yibo/yibo-mx.sqlite
# YIBO_DATABASE_US=/var/lib/yibo/yibo-us.sqlite
# At least 32 random bytes. Required in production so admin sessions survive
# safely with a stable signing key.
YIBO_ADMIN_SESSION_KEY=
YIBO_DASHBOARD_ORIGIN=http://localhost:5173

# Optional appointment email delivery. Without both values, delivery attempts
# are recorded as SKIPPED and never affect appointment success.
RESEND_API_KEY=
YIBO_EMAIL_FROM=

# Optional PBX ingress, enabled only in the API process. Supply all four together.
ASTERISK_ARI_URL=
ASTERISK_ARI_APPLICATION=
ASTERISK_ARI_USERNAME=
ASTERISK_ARI_PASSWORD=
# Bind a private interface reachable by the PBX; firewall these UDP ports to the PBX.
YIBO_ASTERISK_MEDIA_HOST=
YIBO_ASTERISK_MEDIA_PORT_START=
YIBO_ASTERISK_MEDIA_PORT_END=
