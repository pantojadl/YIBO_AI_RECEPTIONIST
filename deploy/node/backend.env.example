# TEMPLATE ONLY. Install privately as /etc/yibo/backend.env on the approved new host.
# The placeholder tenant intentionally prevents startup until configuration is reviewed.
# Do not copy the working phone .env. See docs/DEPLOYMENT_CHECKPOINT.md.
NODE_ENV=production
PORT=3000
DOTENV_CONFIG_PATH=/dev/null
YIBO_DASHBOARD_ORIGIN=https://dashboard.yibo.invalid
YIBO_TENANT_ID=REPLACE_SUPPORTED_TENANT_ID

# Match the selected tenant's existing region. Set its absolute persistent DB path.
# YIBO_REGION alone does not choose the bootstrap tenant or database.
YIBO_REGION=US
YIBO_DATABASE_US=/var/lib/yibo/us.sqlite
# YIBO_DATABASE_MX=/var/lib/yibo/mx.sqlite

# Enter a stable, private value of at least 32 bytes before starting the API.
YIBO_ADMIN_SESSION_KEY=

# Synthetic HTTP acceptance only. Real provider readiness must be checked separately.
YIBO_RUNTIME=in-memory

# Required together for the real Google adapter. Preserve the approved existing
# redirect and original encryption key/grant; do not reauthorize or migrate live data here.
# Leaving these absent selects the in-memory Calendar adapter, NOT real Google writes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# YIBO_TOKEN_ENCRYPTION_KEY=

# Only if already required by the approved deployment; values remain on Node.
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=
# OPENAI_ADMIN_KEY=
# RESEND_API_KEY=
# YIBO_EMAIL_FROM=

# No ASTERISK_ARI_*, YIBO_ASTERISK_MEDIA_*, Telnyx, Voice Lab or Tunnel credentials here.
