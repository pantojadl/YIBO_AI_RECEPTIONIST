# TEMPLATE ONLY. Install privately as /etc/yibo/backup.env after host/storage approval.
# This file does not need Google, OpenAI, ARI, email, or admin-session credentials.
YIBO_BACKUP_ROOT=/var/lib/yibo-backups
YIBO_BACKUP_REGIONS=US
YIBO_DATABASE_US=/var/lib/yibo/us.sqlite
# If this host also owns MX data, enable BOTH lines and set REGIONS=MX,US above.
# YIBO_DATABASE_MX=/var/lib/yibo/mx.sqlite
YIBO_RELEASE_SHA=REPLACE_WITH_40_CHARACTER_DEPLOYED_COMMIT

# Separate private files; never add their contents to Git or the database snapshots.
# Approved remote repository URI, e.g. s3:https://<endpoint>/<bucket>/<prefix>.
RESTIC_REPOSITORY_FILE=/etc/yibo/restic-repository
RESTIC_PASSWORD_FILE=/etc/yibo/restic-password
RESTIC_CACHE_DIR=/var/cache/yibo-restic
# Add only the selected storage provider's required credentials privately.
# Keep independently recoverable copies of the repository password, Google token
# encryption key, admin-session key, and original provider settings in a secret vault.
