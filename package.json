{
  "name": "yibo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "db:init": "tsx src/infrastructure/database/init-databases.ts",
    "db:snapshot": "tsx src/cli/snapshot-database.ts",
    "cost:model": "tsx src/cli/cost-model.ts",
    "asterisk:check": "tsx src/cli/validate-asterisk-templates.ts",
    "asterisk:render": "tsx src/cli/render-asterisk-templates.ts",
    "admin:create": "tsx --env-file=.env src/cli/create-admin.ts",
    "dev": "concurrently -k -n api,dashboard,voice -c cyan,magenta,yellow \"pnpm dev:api\" \"pnpm dev:dashboard\" \"pnpm dev:voice\"",
    "dev:api": "tsx watch src/main.ts",
    "dev:dashboard": "vite --config dashboard/vite.config.ts",
    "dev:voice": "tsx --env-file=.env apps/dev-voice/server.ts",
    "dev:voice:transcript": "tsx --env-file=.env apps/dev-voice/server.ts --transcript",
    "build": "tsc --noEmit && vue-tsc --noEmit -p dashboard/tsconfig.json && vite build --config dashboard/vite.config.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p dashboard/tsconfig.json",
    "test": "vitest run",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "openai": "^7.5.0",
    "vue": "^3.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce"
}
